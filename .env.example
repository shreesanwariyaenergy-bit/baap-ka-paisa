# Where board, member and archive data comes from.
#   demo        - built-in invented data for design review. Every page shows a "Demo data" notice.
#   supabase    - the live BAAP KA PAISA database (needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY).
#   unavailable - no data source connected. Pages show honest empty and "not open yet" states.
# Defaults: demo in development, unavailable in production builds.
BKP_DATA_SOURCE=demo

# Optional. First month that counts as Season 1, as YYYY-MM. Leave unset until the launch month is decided;
# the site then shows the month name without a season number.
# BKP_SEASON_ONE_MONTH=2026-12

# Payments stay off. Nothing in this app reads a payment key or creates an order.
PAYMENTS_ENABLED=false
RANK_PURCHASES_ENABLED=false

# Live database. The publishable key only allows the read functions in supabase/migrations.
# Never put a service-role key here or anywhere in this app.
SUPABASE_URL=https://kxbqaqbistbmxczyqbvq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
