# Where board, member and archive data comes from.
#   demo        - built-in invented data for design review. Every page shows a "Demo data" notice.
#   supabase    - the live BAAP KA PAISA database (needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY).
#   unavailable - no data source connected. Pages show honest empty and "not open yet" states.
# Defaults: demo in development, unavailable in production builds.
BKP_DATA_SOURCE=demo

# Optional. First month that counts as Season 1, as YYYY-MM. Leave unset until the launch month is decided;
# the site then shows the month name without a season number.
# BKP_SEASON_ONE_MONTH=2026-12

# Payments stay off. Nothing in this app reads a payment key or creates an order.
PAYMENTS_ENABLED=false
RANK_PURCHASES_ENABLED=false

# Live database. The publishable key only allows the read functions in supabase/migrations.
# Never put a service-role key here or anywhere in this app.
SUPABASE_URL=https://kxbqaqbistbmxczyqbvq.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Public address (https, no trailing slash). Used for the Seal QR, confirmation-email links and robots.txt.
# Change this one value when the final domain is decided. Until set, the QR points at a reserved placeholder.
# BKP_SITE_URL=https://baap-ka-paisa.vercel.app

# Who may create a profile on the live site: open | testers | closed. Default: closed.
# "testers" needs BKP_TESTER_CODE (8+ characters), entered once per device on /join.
BKP_REGISTRATION=closed
# BKP_TESTER_CODE=

# Label the running season as a test season across the site.
# BKP_SEASON_MODE=test

# Search engines stay blocked until this is true (public launch approval).
BKP_ALLOW_INDEXING=false

# Product email (not sign-in email, which Supabase Auth sends: set its sender under
# Supabase → Authentication → SMTP). Nothing is sent until all three are set.
# BKP_EMAIL_PROVIDER=resend
# BKP_EMAIL_API_KEY=
# BKP_EMAIL_FROM="BAAP KA PAISA <hello@your-domain>"
